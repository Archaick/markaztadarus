rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is signed in ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // Google accounts always carry a verified email; requiring it stops
    // anyone registering an invited address with a password they made up.
    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    // The only account that can invite admins. Mirrored in
    // src/components/Internal/access.js.
    function isSuperAdmin() {
      return hasVerifiedEmail() && signedInEmail() == "saeedhareez@gmail.com";
    }

    function adminPath() {
      return /databases/$(database)/documents/internal_admins/$(signedInEmail());
    }

    // An invited admin who was given this dashboard (or the super admin).
    function hasFeature(feature) {
      return isSuperAdmin()
        || (hasVerifiedEmail()
          && exists(adminPath())
          && get(adminPath()).data.features.hasAny([feature]));
    }

    // ---------- History ----------
    // Every admin write is sent in one batch with an entry in internal_audit
    // (see src/components/Internal/audit.js). Entries can never be changed or
    // deleted, and only the super admin reads them.

    function adminEmail() {
      return hasVerifiedEmail() ? signedInEmail() : "";
    }

    function isAdminAccount() {
      return isSuperAdmin() || (hasVerifiedEmail() && exists(adminPath()));
    }

    function auditPath(id) {
      return /databases/$(database)/documents/internal_audit/$(id);
    }

    // The written document names a history entry made in this same request
    // by this same account.
    function audited() {
      let id = request.resource.data.get("auditId", "none");
      return id is string
        && existsAfter(auditPath(id))
        && getAfter(auditPath(id)).data.at == request.time
        && getAfter(auditPath(id)).data.actor == adminEmail();
    }

    // A delete needs a mark for the version being deleted, made in this same
    // request by this same account (deleting a document that is not there
    // changes nothing), and an exact copy of it in the recycle bin.
    // Mirrored in deleteMarkId().
    function marked(key) {
      let markId = key + "~" + resource.data.get("auditId", "v0");
      let path = /databases/$(database)/documents/internal_audit_marks/$(markId);
      return resource == null || (existsAfter(path)
        && getAfter(path).data.at == request.time
        && getAfter(path).data.actor == adminEmail()
        && binned(getAfter(path).data.get("trash", ""), markId));
    }

    // The deleted document's copy is in the bin, unchanged.
    function binned(group, markId) {
      let item = /databases/$(database)/documents/internal_trash/$(group)/trash_items/$(markId);
      return group is string && group.size() > 0
        && existsAfter(item)
        && getAfter(item).data.data == resource.data;
    }

    // Kept for 30 days (then removed when the super admin opens the Admin app).
    function binExpiry(value) {
      return value is timestamp
        && value > request.time + duration.value(29, "d")
        && value < request.time + duration.value(31, "d");
    }

    // ---------- Recycle bin ----------
    // One entry per delete (a form with its responses is one), holding a copy
    // of each deleted document. Only the super admin sees it, restores from
    // it or empties it.

    function entryMadeNow(id) {
      return id is string
        && existsAfter(auditPath(id))
        && getAfter(auditPath(id)).data.at == request.time
        && getAfter(auditPath(id)).data.actor == adminEmail();
    }

    match /internal_trash/{groupId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminAccount()
        && request.resource.data.keys().hasOnly(["area", "action", "label", "target", "audit", "actor", "actorName", "at", "expiresAt", "count", "kinds"])
        && request.resource.data.actor == adminEmail()
        && request.resource.data.at == request.time
        && binExpiry(request.resource.data.expiresAt)
        && request.resource.data.kinds is map
        && entryMadeNow(request.resource.data.audit);
      // the same admin adding the next part of one delete, or the super admin marking it restored
      allow update: if (isAdminAccount()
          && resource.data.actor == adminEmail()
          && resource.data.get("restoredAt", null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["area", "action", "label", "target", "audit", "count", "kinds"])
          && entryMadeNow(request.resource.data.audit))
        || (isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["restoredAt", "restoredBy"])
          && request.resource.data.restoredAt == request.time
          && request.resource.data.restoredBy == adminEmail());
      allow delete: if isSuperAdmin();

      match /trash_items/{itemId} {
        allow read: if isSuperAdmin();
        allow create: if isAdminAccount()
          && request.resource.data.keys().hasOnly(["path", "data", "actor", "at", "expiresAt"])
          && request.resource.data.actor == adminEmail()
          && request.resource.data.at == request.time
          && request.resource.data.path is string
          && request.resource.data.data is map
          && binExpiry(request.resource.data.expiresAt);
        allow delete: if isSuperAdmin();
      }
    }

    match /internal_audit/{entryId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminAccount()
        && request.resource.data.keys().hasOnly(["at", "actor", "actorName", "area", "action", "target", "label", "details"])
        && request.resource.data.at == request.time
        && request.resource.data.actor == adminEmail()
        && request.resource.data.area in ["certificates", "redirects", "forms", "site", "access", "supervisi", "global", "belajar"]
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.target is string && request.resource.data.target.size() <= 200
        && request.resource.data.label is string && request.resource.data.label.size() <= 200
        && request.resource.data.details is map && request.resource.data.details.size() <= 20;
      // the super admin's cleanup (Activity History → how long to keep):
      // never anything from the last 30 days
      allow delete: if isSuperAdmin() && resource.data.at < request.time - duration.value(30, 'd');
    }

    // How long the history keeps entries: 0 (forever) or 30 days to 10 years.
    match /internal_settings/{docId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin()
        && docId == "history"
        && request.resource.data.keepDays is int
        && (request.resource.data.keepDays == 0
          || (request.resource.data.keepDays >= 30 && request.resource.data.keepDays <= 3650))
        && audited();
      // the figure on the Backup page, added up in the browser
      allow write: if isSuperAdmin()
        && docId in ["storage", "storage_belajar"]
        && request.resource.data.keys().hasOnly(["bytes", "count", "areas", "at"])
        && request.resource.data.bytes is int
        && request.resource.data.count is int
        && request.resource.data.areas is map
        && request.resource.data.at == request.time;
    }

    match /internal_audit_marks/{markId} {
      allow read: if isSuperAdmin();
      allow create: if isAdminAccount()
        && request.resource.data.keys().hasOnly(["at", "actor", "audit", "trash"])
        && request.resource.data.at == request.time
        && request.resource.data.actor == adminEmail()
        && exists(auditPath(request.resource.data.audit)) == false
        && existsAfter(auditPath(request.resource.data.audit));
      allow delete: if isSuperAdmin() && resource.data.at < request.time - duration.value(30, 'd');
    }

    // ---------- Internal admins (invites) ----------

    // Keep this list in step with FEATURES in src/components/Internal/access.js.
    function validAdmin(email) {
      let data = request.resource.data;
      return data.email == email
        && email == email.lower()
        && data.features is list
        && data.features.hasOnly(["certificates", "redirects", "forms", "site", "supervisi", "global", "belajar"]);
    }

    match /internal_admins/{email} {
      allow read: if isSuperAdmin() || (hasVerifiedEmail() && signedInEmail() == email);
      allow create, update: if isSuperAdmin() && validAdmin(email) && audited();
      allow delete: if isSuperAdmin() && marked("admins~" + email);

      // An admin may stamp their own sign-in, so the super admin can see
      // who has accepted an invite. Nothing else on their own record.
      allow update: if hasVerifiedEmail()
        && signedInEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["lastLoginAt", "displayName", "photoURL"]);
    }

    // ---------- Certificates ----------

    // Set by the dashboard once every certificate has a copy in
    // certificate_public; from then on the full records are admin-only.
    function certificatesSecured() {
      let migration = /databases/$(database)/documents/certificate_meta/migration;
      return exists(migration) && get(migration).data.get("done", false) == true;
    }

    // The admin's records. Until the move is done the old verification
    // lookup still needs them, so they stay readable until then.
    match /certificates/{certId} {
      allow read: if hasFeature("certificates") || !certificatesSecured();
      allow create, update: if hasFeature("certificates") && audited();
      allow delete: if hasFeature("certificates") && marked("certificates~" + certId);

      // A picture of page 1 of the Word file stamped with this certificate's
      // QR (the file itself is never stored).
      match /snapshot/{page} {
        allow read: if hasFeature("certificates");
        allow create, update: if hasFeature("certificates")
          && request.resource.data.keys().hasOnly(["dataUrl", "auditId"])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 400000
          && request.resource.data.dataUrl.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")
          && audited();
        allow delete: if hasFeature("certificates") && marked("certificates~" + certId + "~snapshot~" + page);
      }
    }

    // What the verification page shows, one document per code. Anyone may
    // open a code they hold; nobody but an admin may list them.
    match /certificate_public/{code} {
      // A scan: one more and the time, nothing else.
      function isScan() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["scans", "lastScannedAt"])
          && request.resource.data.scans == resource.data.get("scans", 0) + 1
          && request.resource.data.lastScannedAt == request.time;
      }

      allow get: if true;
      allow list: if hasFeature("certificates");
      allow create: if hasFeature("certificates") && code.matches("^[A-Z0-9]{4,32}$") && audited();
      allow update: if (hasFeature("certificates") && audited()) || isScan();
      allow delete: if hasFeature("certificates") && marked("certificate_public~" + code);
    }

    match /certificate_meta/{docId} {
      allow read: if true;
      allow create, update: if hasFeature("certificates") && audited();
      allow delete: if hasFeature("certificates") && marked("certificate_meta~" + docId);
    }

    // Certificate Studio: one event's certificate design (its words, logos,
    // signers, numbering); the certificates themselves stay in `certificates`.
    match /certificate_designs/{designId} {
      allow read: if hasFeature("certificates");
      allow create, update: if hasFeature("certificates") && audited();
      allow delete: if hasFeature("certificates") && marked("certificate_designs~" + designId);
    }

    // What a scan of a Studio certificate shows of its design (the printed
    // page's wording, logos and signers): opened by id, never listed.
    match /certificate_design_public/{designId} {
      allow get: if true;
      allow list: if hasFeature("certificates");
      allow create, update: if hasFeature("certificates") && audited();
      allow delete: if hasFeature("certificates") && marked("certificate_design_public~" + designId);
    }

    // Signers (signature + stamp) shown on verified certificates
    match /certificate_signers/{signerId} {
      // The verification page opens a certificate's own signers by id, or
      // asks for the default ones; nobody else may list every signature.
      allow get: if true;
      allow list: if hasFeature("certificates") || resource.data.isDefault == true;
      allow create, update: if hasFeature("certificates") && audited();
      allow delete: if hasFeature("certificates") && marked("certificate_signers~" + signerId);
    }

    // ---------- Redirect manager ----------

    match /redirect_manager_links/{redirectId} {
      // A short path and an http(s) destination.
      function validLink() {
        let data = request.resource.data;
        return data.source is string && data.source.matches('^/[a-z0-9-]+$')
          && data.destination is string && data.destination.matches('^https?://.+');
      }

      // The waiting page counts a visit: one more click and the time, nothing else.
      function isClickCount() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["clicks", "lastClickedAt"])
          && request.resource.data.clicks == resource.data.get("clicks", 0) + 1
          && request.resource.data.lastClickedAt == request.time;
      }

      // Only the dashboard reads them (with their notes and editors); the
      // short-link page reads redirect_public. Until every link has its copy
      // there, the page may still look one up by path.
      allow get: if hasFeature("redirects") || !redirectsSecured();
      allow list: if hasFeature("redirects") || (request.query.limit <= 1 && !redirectsSecured());
      allow create: if hasFeature("redirects") && validLink() && audited();
      allow update: if (hasFeature("redirects") && validLink() && audited()) || isClickCount();
      allow delete: if hasFeature("redirects") && marked("redirect_manager_links~" + redirectId);
    }

    // Written by the dashboard once every link has its copy in redirect_public.
    function redirectsSecured() {
      return exists(/databases/$(database)/documents/redirect_public/_secured);
    }

    function linkAfter(linkId) {
      return getAfter(/databases/$(database)/documents/redirect_manager_links/$(linkId)).data;
    }

    // What the short-link page needs of a link, one document per path (no
    // leading slash): opened by path, never listed. A copy must match its
    // link exactly as the link is after the same request.
    match /redirect_public/{slug} {
      function matchesLink() {
        let data = request.resource.data;
        let link = linkAfter(data.linkId);
        return data.keys().hasOnly(["linkId", "destination", "title", "active", "expiresAt"])
          && data.linkId is string
          && link.source == "/" + slug
          && data.destination == link.destination
          && data.title == link.get("title", "")
          && data.active == link.get("active", true)
          && data.expiresAt == link.get("expiresAt", null);
      }

      allow get: if true;
      allow list: if hasFeature("redirects");
      allow create, update: if hasFeature("redirects")
        && ((slug == "_secured" && request.resource.data.keys().hasOnly(["at"]) && request.resource.data.at == request.time)
          || (slug != "_secured" && matchesLink()));
      // a copy goes once its link is gone or has moved to another path
      allow delete: if hasFeature("redirects")
        && slug != "_secured"
        && (resource == null
          || !existsAfter(/databases/$(database)/documents/redirect_manager_links/$(resource.data.linkId))
          || linkAfter(resource.data.linkId).source != "/" + slug);
    }

    // ---------- Website content (home page map and achievements) ----------

    match /site_content/{docId} {
      // The home page reads these for every visitor.
      allow read: if true;
      allow write: if (
          (hasFeature("site")
            && docId == "stats"
            && request.resource.data.items is list
            && request.resource.data.items.size() <= 30)
          // Tadarus Global: the countries with programs and, inside Indonesia,
          // the provinces of the home-page map; only from its own dashboard
          || (hasFeature("global")
            && ((docId == "global"
                && request.resource.data.countries is map
                && request.resource.data.countries.size() <= 80)
              || (docId == "map"
                && request.resource.data.provinces is map
                && request.resource.data.provinces.size() <= 40)))
        )
        && audited();
      allow delete: if false;
    }

    // Tadarus Live: the Zoom links of the online sessions, for the Tadarus
    // Global dashboard only; a link shows publicly only when an admin copies
    // it into the public map ("show on /global").
    match /site_private/{docId} {
      allow read: if hasFeature("global");
      allow write: if hasFeature("global")
        && docId == "links"
        && request.resource.data.links is map
        && request.resource.data.links.size() <= 500
        && audited();
      allow delete: if false;
    }

    // ---------- News posts (photos as JPEG data URLs; no Storage bucket) ----------

    function validPost() {
      let data = request.resource.data;
      return data.status in ["draft", "published"]
        && data.title is string && data.title.size() <= 200
        && data.body is string && data.body.size() <= 50000
        && data.date is string && data.date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && data.images is list && data.images.size() <= 30
        && data.coverThumb is string && data.coverThumb.size() <= 120000;
    }

    // A photo in Cloud Storage: its document holds the link and where the file is.
    function inStorage(photo) {
      return photo.get("url", "") is string && photo.get("url", "").matches("https?://.+")
        && photo.get("file", "") is string && photo.get("file", "").matches("posts/.+");
    }

    match /posts/{postId} {
      // Visitors only ever see published posts; drafts stay with the editors.
      allow read: if hasFeature("site") || resource.data.status == "published";
      allow create, update: if hasFeature("site") && validPost() && audited();
      allow delete: if hasFeature("site") && marked("posts~" + postId);

      match /images/{imageId} {
        allow read: if hasFeature("site")
          || get(/databases/$(database)/documents/posts/$(postId)).data.status == "published";
        allow create, update: if hasFeature("site")
          && request.resource.data.keys().hasOnly(["dataUrl", "url", "file", "width", "height", "createdAt", "auditId"])
          && (inStorage(request.resource.data)
            || (request.resource.data.dataUrl is string
              && request.resource.data.dataUrl.size() <= 460000
              && request.resource.data.dataUrl.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")))
          && audited();
        allow delete: if hasFeature("site") && marked("posts~" + postId + "~images~" + imageId);
      }

      // A small copy of each photo (same id) for the gallery grid.
      match /thumbs/{thumbId} {
        allow read: if hasFeature("site")
          || get(/databases/$(database)/documents/posts/$(postId)).data.status == "published";
        allow create, update: if hasFeature("site")
          && request.resource.data.keys().hasOnly(["dataUrl", "url", "file", "width", "height", "auditId"])
          && (inStorage(request.resource.data)
            || (request.resource.data.dataUrl is string
              && request.resource.data.dataUrl.size() <= 80000
              && request.resource.data.dataUrl.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")))
          && audited();
        allow delete: if hasFeature("site") && marked("posts~" + postId + "~thumbs~" + thumbId);
      }
    }

    // ---------- Teacher supervision (SKENARIO SUPERVISI GURU) ----------
    // Schools, their teachers, the editable instruments and one document per
    // supervision (signatures apart). Admins given "supervisi" only.

    match /supervisi_schools/{schoolId} {
      allow read: if hasFeature("supervisi");
      allow create, update: if hasFeature("supervisi") && audited()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.get("cover", "") is string && request.resource.data.get("cover", "").size() <= 160000;
      allow delete: if hasFeature("supervisi") && marked("supervisi_schools~" + schoolId);
    }

    match /supervisi_teachers/{teacherId} {
      allow read: if hasFeature("supervisi");
      allow create, update: if hasFeature("supervisi") && audited()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.schoolId is string
        && request.resource.data.get("photo", "") is string && request.resource.data.get("photo", "").size() <= 80000;
      allow delete: if hasFeature("supervisi") && marked("supervisi_teachers~" + teacherId);
    }

    // the defaults every supervision starts from
    match /supervisi_settings/{docId} {
      allow read: if hasFeature("supervisi");
      allow create, update: if hasFeature("supervisi") && audited()
        && docId == "defaults"
        && request.resource.data.keys().hasOnly(["supervisorName", "supervisorSignature", "supervisorSigns", "showPhotos", "auditId", "updatedAt"])
        && request.resource.data.get("supervisorSignature", "") is string && request.resource.data.get("supervisorSignature", "").size() <= 200000;
      allow delete: if false;
    }

    match /supervisi_instruments/{instrumentId} {
      allow read: if hasFeature("supervisi");
      allow create, update: if hasFeature("supervisi") && audited()
        && request.resource.data.sections is list && request.resource.data.sections.size() <= 30;
      allow delete: if hasFeature("supervisi") && marked("supervisi_instruments~" + instrumentId);
    }

    match /supervisi_sessions/{sessionId} {
      allow read: if hasFeature("supervisi");
      allow create, update: if hasFeature("supervisi") && audited()
        && request.resource.data.status in ["draft", "observing", "done"]
        && request.resource.data.scores is map && request.resource.data.scores.size() <= 400;
      allow delete: if hasFeature("supervisi") && marked("supervisi_sessions~" + sessionId);

      // the two signatures, as small PNG pictures
      match /signatures/{signId} {
        allow read: if hasFeature("supervisi");
        allow create, update: if hasFeature("supervisi") && audited()
          && request.resource.data.keys().hasOnly(["teacher", "supervisor", "auditId"])
          && request.resource.data.teacher is string && request.resource.data.teacher.size() <= 200000
          && request.resource.data.supervisor is string && request.resource.data.supervisor.size() <= 200000;
        allow delete: if hasFeature("supervisi") && marked("supervisi_sessions~" + sessionId + "~signatures~" + signId);
      }
    }

    // ---------- Forms ----------

    match /forms/{formId} {
      // Anyone with the link can load an open or closed form; drafts stay
      // with the admins, and only admins may list the forms.
      allow get: if hasFeature("forms") || resource.data.status in ["open", "closed"];
      allow list: if hasFeature("forms");
      allow create, update: if hasFeature("forms")
        && request.resource.data.status in ["draft", "open", "closed"]
        && request.resource.data.fields is list
        && request.resource.data.fields.size() <= 100
        && audited();
      allow delete: if hasFeature("forms") && marked("forms~" + formId);

      // The cover image, as a JPEG data URL (this project has no Storage
      // bucket). Readable wherever the form itself is.
      match /media/{mediaId} {
        allow read: if hasFeature("forms")
          || get(/databases/$(database)/documents/forms/$(formId)).data.status in ["open", "closed"];
        allow create, update: if hasFeature("forms")
          && mediaId == "cover"
          && request.resource.data.keys().hasOnly(["dataUrl", "updatedAt", "auditId"])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 700000
          && request.resource.data.dataUrl.matches("data:image/jpeg;base64,[A-Za-z0-9+/=]+")
          && audited();
        allow delete: if hasFeature("forms") && marked("forms~" + formId + "~media~" + mediaId);
      }

      // A quiz's answer key: admins only (a copy goes on the form itself only
      // when results are shown right after sending).
      match /private/{docId} {
        allow read: if hasFeature("forms");
        allow create, update: if hasFeature("forms")
          && docId == "key"
          && request.resource.data.key is map
          && request.resource.data.key.size() <= 100
          && audited();
        allow delete: if hasFeature("forms") && marked("forms~" + formId + "~private~" + docId);
      }

      match /responses/{responseId} {
        // Anyone may answer an open form, once per write, with only answers.
        allow create: if get(/databases/$(database)/documents/forms/$(formId)).data.status == "open"
          && request.resource.data.keys().hasOnly(["answers", "submittedAt"])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 100
          && request.resource.data.submittedAt == request.time;
        // ...and an admin may put one back from the recycle bin as it was
        allow create: if hasFeature("forms")
          && request.resource.data.answers is map
          && audited();
        allow read: if hasFeature("forms");
        // a quiz's points given by hand; nothing else of an answer changes
        allow update: if hasFeature("forms")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["grades", "auditId"])
          && request.resource.data.grades is map
          && request.resource.data.grades.size() <= 100
          && audited();
        allow delete: if hasFeature("forms") && marked("forms~" + formId + "~responses~" + responseId);
      }
    }

    // Deny everything else
    // ---------- Belajar 5T (the learning platform, /belajar) ----------
    // Buku Guru lessons (one per surah, with the 5T material) and their
    // sections (reading, questions with answers, written tasks). Admins given
    // "belajar" only for now; teachers (/guru) will get read access later.

    match /belajar_lessons/{lessonId} {
      // learners (any signed-in Google account) see only published surahs
      allow read: if hasFeature("belajar") || (hasVerifiedEmail() && resource.data.get("published", false) == true);
      allow create, update: if hasFeature("belajar") && audited()
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.get("program", "guru") in ["guru", "anak"]
        && request.resource.data.get("published", false) is bool
        && request.resource.data.get("ayat", []) is list && request.resource.data.get("ayat", []).size() <= 300;
      allow delete: if isSuperAdmin() && marked("belajar_lessons~" + lessonId); // whole items: the super admin only
    }

    match /belajar_sections/{sectionId} {
      allow read: if hasFeature("belajar") || hasVerifiedEmail();
      allow create, update: if hasFeature("belajar") && audited()
        && request.resource.data.lessonId is string
        && request.resource.data.key is string && request.resource.data.key.size() <= 40
        && request.resource.data.kind in ["quiz", "reading", "written"]
        && request.resource.data.get("parts", []) is list && request.resource.data.get("parts", []).size() <= 10
        && request.resource.data.get("tasks", []) is list && request.resource.data.get("tasks", []).size() <= 30
        && request.resource.data.get("reading", []) is list && request.resource.data.get("reading", []).size() <= 80;
      allow delete: if isSuperAdmin() && marked("belajar_sections~" + sectionId); // whole items: the super admin only
    }

    // ---------- Belajar 5T: classes and learners (/guru, later /anak) ----------
    // A class (Kelas) has the surahs assigned to it and a join code. A
    // learner is any Google account that joined a class with its code or was
    // invited by email; they may only add classes they have a code or an
    // invite for, and write only their own progress (never undoing "done").

    function learnerPath(uid) {
      return /databases/$(database)/documents/belajar_learners/$(uid);
    }

    function inClass(classId) {
      return isSignedIn()
        && exists(learnerPath(request.auth.uid))
        && get(learnerPath(request.auth.uid)).data.classIds.hasAny([classId]);
    }

    match /belajar_classes/{classId} {
      allow read: if hasFeature("belajar") || inClass(classId);
      allow create, update: if hasFeature("belajar") && audited()
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.lessonIds is list && request.resource.data.lessonIds.size() <= 120
        && request.resource.data.code is string && request.resource.data.code.size() <= 12;
      allow delete: if isSuperAdmin() && marked("belajar_classes~" + classId); // whole items: the super admin only
    }

    // CODE -> class; a signed-in learner looks one up to join
    match /belajar_codes/{code} {
      allow get: if isSignedIn();
      allow list: if hasFeature("belajar");
      allow create, update: if hasFeature("belajar") && audited()
        && request.resource.data.keys().hasOnly(["classId", "active", "auditId", "createdAt", "updatedAt"])
        && request.resource.data.classId is string
        && request.resource.data.active is bool;
      allow delete: if isSuperAdmin() && marked("belajar_codes~" + code); // whole items: the super admin only
    }

    // classes an email was invited to, claimed when that account signs in
    match /belajar_invites/{email} {
      allow read: if hasFeature("belajar") || (hasVerifiedEmail() && signedInEmail() == email);
      allow create, update: if hasFeature("belajar") && audited()
        && email == email.lower()
        && request.resource.data.classIds is list && request.resource.data.classIds.size() <= 50;
      allow delete: if hasFeature("belajar") && marked("belajar_invites~" + email);
    }

    // the classes a learner may add in this write: the code's class and their invites
    function learnerAdds(uid) {
      let before = resource == null ? [] : resource.data.get("classIds", []);
      let added = request.resource.data.classIds.removeAll(before);
      let code = request.resource.data.get("joinCode", "none");
      let codePath = /databases/$(database)/documents/belajar_codes/$(code);
      let viaCode = (code is string && code.size() > 0 && code.size() <= 12 && exists(codePath) && get(codePath).data.active == true)
        ? [get(codePath).data.classId] : [];
      let invitePath = /databases/$(database)/documents/belajar_invites/$(signedInEmail());
      let viaInvite = exists(invitePath) ? get(invitePath).data.classIds : [];
      return added.hasOnly(viaCode.concat(viaInvite));
    }

    match /belajar_learners/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || hasFeature("belajar");
      allow create, update: if hasVerifiedEmail() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "email", "name", "photoURL", "classIds", "joinCode", "joinedAt", "lastSeenAt", "auditId", "updatedAt"])
        && request.resource.data.uid == uid
        && request.resource.data.email == signedInEmail()
        && request.resource.data.classIds is list && request.resource.data.classIds.size() <= 50
        && (resource == null || request.resource.data.get("auditId", "") == resource.data.get("auditId", ""))
        && learnerAdds(uid);
      // an admin takes someone out of a class
      allow update: if hasFeature("belajar") && audited()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classIds", "auditId", "updatedAt"]);
      // a deleted teacher put back from the recycle bin
      allow create: if hasFeature("belajar") && audited()
        && request.resource.data.uid == uid && request.resource.data.classIds is list;
      allow delete: if isSuperAdmin() && marked("belajar_learners~" + uid); // whole items: the super admin only
    }

    function validProgress() {
      let data = request.resource.data;
      return data.keys().hasOnly(["uid", "lessonId", "sectionId", "sectionKey", "best", "last", "max", "attempts", "done", "doneAt", "answers", "submittedAt", "updatedAt", "note", "noteBy", "noteAt", "auditId"])
        && data.uid is string && data.sectionId is string && data.lessonId is string
        && data.get("answers", {}) is map && data.get("answers", {}).size() <= 40
        && data.get("attempts", 0) is int && data.get("attempts", 0) <= 100000;
    }

    match /belajar_progress/{progressId} {
      allow read: if (isSignedIn() && resource.data.uid == request.auth.uid) || hasFeature("belajar");
      // only while the teacher still has a learner record: a deleted teacher saves nothing more
      allow create: if isSignedIn()
        && exists(learnerPath(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && progressId == request.auth.uid + "_" + request.resource.data.sectionId
        && validProgress()
        && !request.resource.data.keys().hasAny(["note", "noteBy", "noteAt", "auditId"]);
      allow update: if isSignedIn()
        && exists(learnerPath(request.auth.uid))
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.sectionId == resource.data.sectionId
        && validProgress()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["note", "noteBy", "noteAt", "auditId"])
        && (resource.data.get("done", false) == false || request.resource.data.get("done", false) == true);
      // a deleted teacher's progress put back from the recycle bin
      allow create: if hasFeature("belajar") && audited() && validProgress()
        && progressId == request.resource.data.uid + "_" + request.resource.data.sectionId;
      // the admin's note on a written answer
      allow update: if hasFeature("belajar") && audited()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["note", "noteBy", "noteAt", "auditId"]);
      allow delete: if isSuperAdmin() && marked("belajar_progress~" + progressId); // whole items: the super admin only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
