rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCertificateAdminUser() {
      return isSignedIn()
        && request.auth.token.email == "saeedhareez@gmail.com";
    }

    function isRedirectAdminUser() {
      return isSignedIn()
        && request.auth.token.email == "info@markazalhijaz.org";
    }

    // Certificates collection
    match /certificates/{certId} {
      // Public read for QR verification
      allow read: if true;

      // Only certificate admin user can manage certificates
      allow create, update, delete: if isCertificateAdminUser();
    }

    // Signers (signature + stamp) shown on verified certificates
    match /certificate_signers/{signerId} {
      // Public read so the verification page can show signatures
      allow read: if true;

      // Only certificate admin user can manage signers
      allow create, update, delete: if isCertificateAdminUser();
    }

    // Redirect manager collection
    match /redirect_manager_links/{redirectId} {
      // Public read so short-link resolver can fetch destination
      allow read: if true;

      // Only redirect admin user can manage redirects
      allow create, update, delete: if isRedirectAdminUser();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
